#!/bin/sh
# O.G Shop commit-msg hook
# Enforce commit cleanliness: prevent and strip AI co-author / bot trailers
COMMIT_MSG_FILE="$1"

if [ -f "$COMMIT_MSG_FILE" ]; then
    # Remove AI / bot co-author lines
    sed -i -E '/^[[:space:]]*[Cc]o-[Aa]uthored-[Bb]y:[[:space:]]*.*([Cc]laude|[Aa]nthropic|[Gg]emini|[Cc]opilot|[Bb]ot|[Aa][Ii]|noreply)/d' "$COMMIT_MSG_FILE"
fi
exit 0
