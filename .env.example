# ==============================================================================
# O.G SHOP (OLD BUT GOLD) - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Hướng dẫn: Sao chép file này thành .env và điền các giá trị thực tế của bạn:
# cp .env.example .env
# ==============================================================================

# Database
POSTGRES_SERVER_NAME="O.G Shop Local"
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=og_shop
POSTGRES_USER=og_shop
POSTGRES_PASSWORD=root

DB_URL=jdbc:postgresql://localhost:55432/og_shop
DB_USERNAME=og_shop
DB_PASSWORD=root

# Networking
BACKEND_PORT=8080
FRONTEND_PORT=5174
APP_FRONTEND_ORIGIN=http://localhost:5174

# Security & JWT
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
AUTH_ACCESS_TOKEN_TTL=PT15M
AUTH_SESSION_COOKIE_NAME=og_access
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_PATH=/api/v1/auth

# Google Sign-In (public Web Client ID, not Gmail app password)
# Configure Authorized JavaScript origins; docs/setup/GOOGLE_AUTH.md
GOOGLE_CLIENT_ID=

# Email OTP: disabled until a local SMTP inbox or a real sender is configured.
# Gmail setup: docs/setup/EMAIL_OTP.md; use an app password, never account password.
OTP_MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ogshop.test
REGISTRATION_OTP_TTL=PT5M
REGISTRATION_DRAFT_TTL=PT30M
REGISTRATION_RESEND_COOLDOWN=PT60S

# VNPAY sandbox (required by backend configuration)
# Replace both placeholders with credentials issued for your sandbox merchant.
# These example values allow local configuration only; they cannot pay at VNPAY.
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=replace-with-sandbox-tmn-code
VNPAY_HASH_SECRET=replace-with-sandbox-hash-secret
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay-ipn
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
# VNPAY cannot reach localhost. Provider E2E requires a registered public HTTPS
# IPN URL and sandbox merchant configuration; never commit actual credentials.

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# eKYC
EKYC_SERVICE_URL=http://localhost:8001
EKYC_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
EKYC_CONNECT_TIMEOUT=PT3S
EKYC_READ_TIMEOUT=PT60S
EKYC_GEMINI_POSTPROCESSING_ENABLED=false
EKYC_ALLOW_SYNTHETIC_DATA_ONLY=true

# Modes
SELLER_VERIFICATION_MODE=MVP_BYPASS
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=60MB

# ==============================================================================
# CẢNH BÁO BẢO MẬT (CHỈ DÀNH CHO MÔI TRƯỜNG DEV/TEST/LOCAL):
# Các giá trị dưới đây chỉ phục vụ kiểm thử và mô phỏng giao hàng local.
# Tuyệt đối KHÔNG bật trên môi trường PRODUCTION (PROD):
# - APP_ENVIRONMENT trên PROD phải là PROD (hoặc không khai báo để nhận mặc định).
# - GHN_SIMULATION_ENABLED trên PROD bắt buộc là false.
# - VITE_SIMULATION_ENABLED trên PROD bắt buộc là false.
# ==============================================================================

# Application Environment (mặc định PROD nếu không khai báo; dùng DEV/STG/PROD)
APP_ENVIRONMENT=DEV

# VNPAY Sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay-ipn

# GHN (Giao Hàng Nhanh) Sandbox
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/
GHN_API_TOKEN=
GHN_SHOP_ID=
# Mô phỏng bưu tá giao hàng GHN (chỉ bật ở DEV/STG cho demo/test; mặc định fail-closed = false trên PROD)
GHN_SIMULATION_ENABLED=true
# Frontend: ẩn/hiện nút mô phỏng [Test] (tương ứng GHN_SIMULATION_ENABLED; PROD bắt buộc = false)
VITE_SIMULATION_ENABLED=true


