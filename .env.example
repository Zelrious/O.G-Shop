# ==============================================================================
# O.G SHOP (OLD BUT GOLD) - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# ==============================================================================
# Hướng dẫn sử dụng:
# 1. Sao chép file này thành .env ở thư mục gốc dự án:
#    cp .env.example .env     (hoặc Copy-Item .env.example .env trên PowerShell)
# 2. Cập nhật các thông tin đăng nhập hoặc API token của bạn (nếu có).
# 3. Khởi động các dịch vụ: Docker (PostgreSQL), Backend (Spring Boot), Frontend (Vite).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MÔI TRƯỜNG ỨNG DỤNG (APPLICATION ENVIRONMENT)
# ------------------------------------------------------------------------------
# Các giá trị hợp lệ: DEV, STG, PROD (mặc định PROD nếu không khai báo)
APP_ENVIRONMENT=DEV

# Chế độ kích hoạt người bán (SELLER_VERIFICATION_MODE): MVP_BYPASS hoặc MANUAL
SELLER_VERIFICATION_MODE=MVP_BYPASS

# Giới hạn kích thước upload tệp tin multipart
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=60MB

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (DATABASE CONFIGURATION)
# ------------------------------------------------------------------------------
# Cấu hình container Docker PostgreSQL (compose.yaml):
POSTGRES_DB=og_shop
POSTGRES_USER=og_shop
POSTGRES_PASSWORD=root
POSTGRES_PORT=55432

# Cấu hình JDBC DataSource cho Backend Spring Boot (application.yml):
DB_URL=jdbc:postgresql://localhost:55432/og_shop
DB_USERNAME=og_shop
DB_PASSWORD=root

# ------------------------------------------------------------------------------
# 3. CỔNG MẠNG & ĐIỀU HƯỚNG (NETWORKING & CORS)
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=5174

# Địa chỉ Frontend dùng để cấu hình CORS cho Backend (khớp với URL frontend đang chạy):
APP_FRONTEND_ORIGIN=http://localhost:5174

# ------------------------------------------------------------------------------
# 4. BẢO MẬT & PHIÊN ĐĂNG NHẬP (SECURITY, JWT & SESSION COOKIE)
# ------------------------------------------------------------------------------
# Khóa ký JWT (bắt buộc ít nhất 32 bytes ngẫu nhiên):
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
AUTH_ACCESS_TOKEN_TTL=PT15M

# Cấu hình Cookie phiên đăng nhập HttpOnly:
AUTH_SESSION_COOKIE_NAME=og_access
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_PATH=/api/v1/auth

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH2 SIGN-IN (TÙY CHỌN)
# ------------------------------------------------------------------------------
# Web Client ID công khai từ Google Cloud Console (docs/setup/GOOGLE_AUTH.md)
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 6. DỊCH VỤ EMAIL OTP & ĐĂNG KÝ (SMTP CONFIGURATION)
# ------------------------------------------------------------------------------
# Mặc định tắt (false) trên local dev; xem hướng dẫn docs/setup/EMAIL_OTP.md
OTP_MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ogshop.test

# Thời hạn OTP và lưu trữ bản nháp đăng ký:
REGISTRATION_OTP_TTL=PT5M
REGISTRATION_DRAFT_TTL=PT30M
REGISTRATION_RESEND_COOLDOWN=PT60S

# ------------------------------------------------------------------------------
# 7. CỔNG THANH TOÁN VNPAY SANDBOX
# ------------------------------------------------------------------------------
# Điền thông tin Sandbox Merchant do VNPAY cấp (docs/setup/VNPAY.md)
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# URL nhận phản hồi khi thanh toán hoàn tất trên trình duyệt:
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return

# URL nhận thông báo tức thời (IPN) từ VNPAY (cần domain HTTPS công khai như ngrok khi test thực tế):
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay-ipn

# ------------------------------------------------------------------------------
# 8. TÍCH HỢP GIAO HÀNG NHANH (GHN SANDBOX & FULFILLMENT)
# ------------------------------------------------------------------------------
# Cổng API thử nghiệm GHN Sandbox (Sandbox: dev-online-gateway.ghn.vn / Live: online-gateway.ghn.vn)
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/

# Token API và Mã cửa hàng do GHN cấp:
GHN_API_TOKEN=
GHN_SHOP_ID=

# Secret key xác thực Webhook gửi từ GHN (tùy chọn trong môi trường dev):
GHN_WEBHOOK_SECRET=

# Bật/tắt worker quét đối soát định kỳ các đơn hàng chưa có mã vận đơn:
GHN_RECONCILIATION_ENABLED=true

# ------------------------------------------------------------------------------
# 9. CHẾ ĐỘ MÔ PHỎNG KIỂM THỬ GIAO HÀNG (SIMULATION - CHỈ DÙNG DEV/TEST)
# ------------------------------------------------------------------------------
# CẢNH BÁO: Chỉ bật trên DEV/STG để test nút mô phỏng giao hàng.
# Trên môi trường PRODUCTION, các biến này bắt buộc = false (hệ thống fail-closed chặn tuyệt đối).
GHN_SIMULATION_ENABLED=true
VITE_SIMULATION_ENABLED=true

# ------------------------------------------------------------------------------
# 10. DỊCH VỤ EKYC AI MICROSERVICE (OCR CCCD & KHUÔN MẶT)
# ------------------------------------------------------------------------------
EKYC_SERVICE_URL=http://localhost:8001
EKYC_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
EKYC_CONNECT_TIMEOUT=PT3S
EKYC_READ_TIMEOUT=PT60S
EKYC_GEMINI_POSTPROCESSING_ENABLED=false
EKYC_ALLOW_SYNTHETIC_DATA_ONLY=true

# ------------------------------------------------------------------------------
# 11. DỊCH VỤ LƯU TRỮ ẢNH CLOUDINARY (TÙY CHỌN)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
